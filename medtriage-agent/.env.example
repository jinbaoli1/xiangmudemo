# ===== LLM 配置 =====
# OpenAI 兼容接口配置，留空则使用 Mock 模式
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

# ===== 应用配置 =====
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ===== 向量检索配置 =====
# 当无 LLM API 时使用纯关键词匹配
VECTOR_INDEX_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ===== 分诊配置 =====
TRIAGE_TOP_K=3
TRIAGE_CONFIDENCE_THRESHOLD=0.5
SEVERITY_HIGH_KEYWORDS=胸痛,呼吸困难,意识不清,大出血,剧烈头痛,中风,心梗,昏迷,抽搐,窒息

# ===== 数据库 =====
# 当前使用 JSON 文件模拟，预留 SQLite 配置
DB_TYPE=json
DB_PATH=data/
