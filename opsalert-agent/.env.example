# LLM 配置 - 兼容 OpenAI 接口
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
# 设置为 true 时使用内置 mock LLM，无需真实 API
LLM_USE_MOCK=true

# 向量模型配置
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_USE_MOCK=true

# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库
DATABASE_URL=sqlite:///./data/opsalert.db
