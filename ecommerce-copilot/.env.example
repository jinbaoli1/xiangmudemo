# ==========================================
# Commerce Copilot 环境配置示例
# 复制此文件为 .env 并填入实际值
# ==========================================

# ---- LLM 配置 ----
# OpenAI 兼容接口配置（支持任何 OpenAI 兼容 API，如 DeepSeek、Qwen、智谱等）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# Embedding 配置
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ---- 应用配置 ----
APP_NAME=Commerce Copilot
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ---- 数据库配置 ----
DATABASE_URL=sqlite:///./ecommerce.db

# ---- 检索配置 ----
HYBRID_SEARCH_TOP_K=10
RERANK_TOP_N=3
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6

# ---- Mock 模式 ----
# 当 LLM_API_KEY 为空时自动启用 Mock 模式，不调用真实 LLM API
MOCK_MODE=auto

# ---- 售后规则配置 ----
REFUND_MAX_DAYS=7
EXCHANGE_MAX_DAYS=15
MAX_REFUND_AMOUNT=10000
